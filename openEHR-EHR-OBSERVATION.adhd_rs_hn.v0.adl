definition
	OBSERVATION[at0000] matches {    -- ADHD RS hn
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0009] occurrences matches {0..1} matches {    -- Klarer ikke være nøye med detaljer eller gjør slurvefeil i skolearbeidet
										value matches {
											0|[local::at0010],
											1|[local::at0011],
											2|[local::at0012],
											3|[local::at0013]
										}
									}
									ELEMENT[at0014] occurrences matches {0..1} matches {    -- Trommer med fingrene / beina eller vrir seg på stolen
										value matches {
											0|[local::at0015],
											1|[local::at0016],
											2|[local::at0017],
											3|[local::at0018]
										}
									}
									ELEMENT[at0020] occurrences matches {0..1} matches {    -- Har problemer med å og opprettholde oppmerksomhet mht. oppgaver eller aktiviteter
										value matches {
											0|[local::at0021],
											1|[local::at0022],
											2|[local::at0023],
											3|[local::at0024]
										}
									}
									ELEMENT[at0025] occurrences matches {0..1} matches {    -- Forlater plassen sin i klasserommet eller i andre situasjoner der det er forventet å sitte stille
										value matches {
											0|[local::at0026],
											1|[local::at0027],
											2|[local::at0028],
											3|[local::at0029]
										}
									}
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Synes ikke å høre etter når han/ hun snakkes direkte til
										value matches {
											0|[local::at0005],
											1|[local::at0006],
											2|[local::at0007],
											3|[local::at0008]
										}
									}
									ELEMENT[at0030] occurrences matches {0..1} matches {    -- Løper rundt eller klatrer overdrevent mye i situasjoner der det er upassende
										value matches {
											0|[local::at0031],
											1|[local::at0032],
											2|[local::at0033],
											3|[local::at0034]
										}
									}
									ELEMENT[at0035] occurrences matches {0..1} matches {    -- Får ikke med seg hele beskjeder og får ikke fullført arbeid
										value matches {
											0|[local::at0036],
											1|[local::at0037],
											2|[local::at0038],
											3|[local::at0039]
										}
									}
									ELEMENT[at0040] occurrences matches {0..1} matches {    -- Har problemer med å leke eller delta i fritidsaktiviteter stille og rolig
										value matches {
											0|[local::at0041],
											1|[local::at0042],
											2|[local::at0043],
											3|[local::at0044]
										}
									}
									ELEMENT[at0045] occurrences matches {0..1} matches {    -- Har problemer med å organisere oppgaver og aktiviteter
										value matches {
											0|[local::at0046],
											1|[local::at0047],
											2|[local::at0048],
											3|[local::at0049]
										}
									}
									ELEMENT[at0050] occurrences matches {0..1} matches {    -- Er ”på farten” eller oppfører seg ”som drevet av en indre motor”
										value matches {
											0|[local::at0051],
											1|[local::at0052],
											2|[local::at0053],
											3|[local::at0054]
										}
									}
									ELEMENT[at0055] occurrences matches {0..1} matches {    -- Unngår oppgaver (for eksempel skolearbeid, lekser) som krever intellektuell innsats (”tenkearbeid”)
										value matches {
											0|[local::at0056],
											1|[local::at0057],
											2|[local::at0058],
											3|[local::at0059]
										}
									}
									ELEMENT[at0060] occurrences matches {0..1} matches {    -- Snakker svært mye
										value matches {
											0|[local::at0061],
											1|[local::at0062],
											2|[local::at0063],
											3|[local::at0064]
										}
									}
									ELEMENT[at0065] occurrences matches {0..1} matches {    -- Mister tin han / hun trenger til aktiviteter eller oppgaver
										value matches {
											0|[local::at0066],
											1|[local::at0067],
											2|[local::at0068],
											3|[local::at0069]
										}
									}
									ELEMENT[at0070] occurrences matches {0..1} matches {    -- Kommer med svar før spørsmålet er fullført
										value matches {
											0|[local::at0071],
											1|[local::at0072],
											2|[local::at0073],
											3|[local::at0074]
										}
									}
									ELEMENT[at0075] occurrences matches {0..1} matches {    -- Er lett å distrahere
										value matches {
											0|[local::at0076],
											1|[local::at0077],
											2|[local::at0078],
											3|[local::at0079]
										}
									}
									ELEMENT[at0080] occurrences matches {0..1} matches {    -- Har problemer med å vente på tur
										value matches {
											0|[local::at0081],
											1|[local::at0082],
											2|[local::at0083],
											3|[local::at0084]
										}
									}
									ELEMENT[at0085] occurrences matches {0..1} matches {    -- Er glemsom i dagliglivet
										value matches {
											0|[local::at0086],
											1|[local::at0087],
											2|[local::at0088],
											3|[local::at0089]
										}
									}
									ELEMENT[at0090] occurrences matches {0..1} matches {    -- Avbryter eller trenger seg på andre
										value matches {
											0|[local::at0091],
											1|[local::at0092],
											2|[local::at0093],
											3|[local::at0094]
										}
									}
									ELEMENT[at0096] occurrences matches {0..1} matches {    -- Oppmerksomhetssvikt
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..24|}
											}
										}
									}
									ELEMENT[at0097] occurrences matches {0..1} matches {    -- Impulsivitet
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..30|}
											}
										}
									}
									ELEMENT[at0098] occurrences matches {0..1} matches {    -- Totalskår
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..54|}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0019] matches {*}    -- Item tree
		}
	}

