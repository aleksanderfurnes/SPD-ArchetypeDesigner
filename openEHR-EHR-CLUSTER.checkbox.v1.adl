definition
	CLUSTER[at0000] matches {    -- Checkbox
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Checkbox
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
		}
	}

