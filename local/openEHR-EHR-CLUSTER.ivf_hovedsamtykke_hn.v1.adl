definition
	CLUSTER[at0000] matches {    -- ivf_hovedsamtykke_hn
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] matches {    -- Jeg samtykker til nedfrysing av befruktede egg
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- Ja
							at0003]    -- Nei
						}
					}
				}
			}
			ELEMENT[at0005] matches {    -- Jeg samtykker til forskning på ubenyttede nedfryste egg
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0006,    -- Ja
							at0007]    -- Nei
						}
					}
				}
			}
			ELEMENT[at0008] matches {    -- Jeg samtykker til dette
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0009,    -- Ja
							at0010]    -- Nei
						}
					}
				}
			}
			ELEMENT[at0020] matches {    -- Jeg bekrefter å ha mottatt informasjonen ovenfor fra IVF-poliklinikken, UNN Tromsø, og samtykker herved til behandling med assistert befruktning
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0021,    -- Ja
							at0022]    -- Nei
						}
					}
				}
			}
			CLUSTER[at0013] occurrences matches {0..1} matches {    -- For kvinnen
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0014] matches {    -- Jeg samtykker til at navn og fødselsnr sendes til registrering i Medisinsk fødselsregister
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0015,    -- Ja
									at0016]    -- Nei
								}
							}
						}
					}
					ELEMENT[at0017] matches {    -- Jeg samtykker til innhenting av disse opplysningene
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0018,    -- Ja
									at0019]    -- Nei
								}
							}
						}
					}
				}
			}
		}
	}

