definition
	CLUSTER[at0000] matches {    -- Mdt tilleggsinformasjon dips
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Pasienten skal møte fysisk i MDT møte
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Hvem informerer pasienten om konkulsjon av møte
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

