	other_contributors = <"Marte Vassli Gullesen, HelseNord IKT HF, Norway","Heather Leslie, Atomica Informatics, Australia (openEHR Editor)">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Å registrere resultatene for hver enkelt komponent og deres totale sum for den kliniker-vurderte Harris hofteskår (HHS), samt det tilhørende pasientrapporterte målet, den modifiserte Harris hofteskår (mHHS).">
			keywords = <"artroplastikk","brudd","artrose","hofte","Harris hofteskår","modifisert Harris hofteskår">
			copyright = <"© openEHR Foundation">
			use = <"Brukes til å registrere:

resultatene for hver komponentparameter og deres totale sum for Harris hofteskår, som omfatter både pasientrapporterte mål på smerte og funksjon, samt kliniker-vurderte funn av bevegelsesutslag og deformitet; og

resultatene for delsettet av parametere som utgjør Modified Harris hofteskår, som kun inkluderer de pasientrapporterte komponentene fra den opprinnelige Harris hofteskår og utelater alle kliniker-vurderte undersøkelsesfunn.

skåren for Modified Harris hofteskår, registrert enten som:
– en «rå» skår, som er den faktiske summen av de pasientrapporterte komponentene, med en maksimal verdi på 91, og
– en «normalisert» skår, som representerer den rå skåren uttrykt på en 0–100-skala for sammenlignbarhet med den opprinnelige Harris hofteskår.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the results for each component parameter and their total sum for the clinician-assessed Harris Hip Score (HHS), and the associated patient-reported outcome measure, the Modified Harris Hip Score (mHHS).">
			keywords = <"arthroplasty","fractures","osteoarthritis","hip","HHS","mHHS">
			use = <"Use to record:
- the results for each component parameter and their total sum for the Harris Hip Score, which includes both patient-reported measures of pain and function and clinician-assessed findings of range of motion and deformity; and
- the results for the subset of parameters that form the Modified Harris Hip Score, which includes only the patient-reported components from the original Harris Hip Score and omits all clinician-assessed examination findings. 
- the score for the Modified Harris Hip Score, recorded as either: 
  -- a 'raw' score, being the actual sum of the patient-reported components, with a maximum value of 91; and
  -- a 'normalised' score, representing the raw score expressed on a 0–100 scale for comparability with the original Harris Hip Score.

While openEHR archetypes are all freely available under an open license, it is not clear if the specific content of this Harris Hip Score archetype is copyright protected. The original source was published in 1969 by Dr William Harris. Any use of this archetype within implementations should be in compliance with the terms established by the copyright owners, if available.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Harris WH. Traumatic arthritis of the hip after dislocation and acetabular fractures: treatment by mold arthroplasty. An end-result study using a new method of result evaluation. J Bone Joint Surg Am. 1969 Jun;51(4):737-55. PMID: 5783851.

Söderman P, Malchau H. Is the Harris hip score system useful to study the outcome of total hip replacement? Clin Orthop Relat Res. 2001 Mar;(384):189-97. doi: 10.1097/00003086-200103000-00022. PMID: 11249165.

Wamper KE, Sierevelt IN, Poolman RW, Bhandari M, Haverkamp D. The Harris hip score: Do ceiling effects limit its usefulness in orthopedics? Acta Orthop. 2010 Dec;81(6):703-7. doi: 10.3109/17453674.2010.537808. PMID: 21110703; PMCID: PMC3216080.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"bc223a57dd1480a7a3a4d22ddcbe11b6">
		["build_uid"] = <"0adca63c-dc5e-4021-8500-19c084247cbf">
		["ip_acknowledgements"] = <"This artefact includes content from SNOMED Clinical Terms® (SNOMED CT®) which is copyrighted material of the International Health Terminology Standards Development Organisation (IHTSDO). Where an implementation of this artefact makes use of SNOMED CT content, the implementer must have the appropriate SNOMED CT Affiliate license - for more information contact https://www.snomed.org/snomed-ct/get-snomed or info@snomed.org.">
		["revision"] = <"0.0.1-alpha">
	>

definition
	OBSERVATION[at0000] matches {    -- Harris Hip Score (HHS)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Pain
										value matches {
											44|[local::at0005],
											40|[local::at0006],
											30|[local::at0007],
											20|[local::at0008],
											10|[local::at0009],
											0|[local::at0010]
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Support devices
										value matches {
											11|[local::at0012],
											7|[local::at0013],
											5|[local::at0014],
											3|[local::at0015],
											2|[local::at0016],
											0|[local::at0017]
										}
									}
									ELEMENT[at0018] occurrences matches {0..1} matches {    -- Distance walked
										value matches {
											11|[local::at0019],
											8|[local::at0020],
											5|[local::at0021],
											2|[local::at0022],
											0|[local::at0023]
										}
									}
									ELEMENT[at0024] occurrences matches {0..1} matches {    -- Limp
										value matches {
											11|[local::at0025],
											8|[local::at0026],
											5|[local::at0027],
											0|[local::at0028]
										}
									}
									ELEMENT[at0029] occurrences matches {0..1} matches {    -- Shoes and socks
										value matches {
											4|[local::at0030],
											2|[local::at0031],
											0|[local::at0032]
										}
									}
									ELEMENT[at0033] occurrences matches {0..1} matches {    -- Stairs
										value matches {
											4|[local::at0034],
											2|[local::at0035],
											1|[local::at0036],
											0|[local::at0037]
										}
									}
									ELEMENT[at0038] occurrences matches {0..1} matches {    -- Public transportation
										value matches {
											1|[local::at0039],
											0|[local::at0040]
										}
									}
									ELEMENT[at0041] occurrences matches {0..1} matches {    -- Sitting
										value matches {
											5|[local::at0042],
											3|[local::at0043],
											0|[local::at0044]
										}
									}
									ELEMENT[at0048] occurrences matches {0..1} matches {    -- Absence of deformity
										value matches {
											4|[local::at0177],
											0|[local::at0176]
										}
									}
									ELEMENT[at0052] occurrences matches {0..1} matches {    -- Total degrees of flexion
										value matches {
											0.0|[local::at0053],
											0.04|[local::at0054],
											0.08|[local::at0055],
											1.2|[local::at0056],
											1.6|[local::at0057],
											2.0|[local::at0058],
											2.25|[local::at0059],
											2.55|[local::at0060],
											2.85|[local::at0061],
											3.0|[local::at0062],
											3.15|[local::at0063],
											3.3|[local::at0064],
											3.6|[local::at0065],
											3.75|[local::at0066],
											3.9|[local::at0067]
										}
									}
									ELEMENT[at0068] occurrences matches {0..1} matches {    -- Total degrees of abduction
										value matches {
											0.0|[local::at0163],
											0.2|[local::at0164],
											0.4|[local::at0165],
											0.6|[local::at0166],
											0.65|[local::at0167]
										}
									}
									ELEMENT[at0074] occurrences matches {0..1} matches {    -- Total degrees of external rotation
										value matches {
											0.0|[local::at0168],
											0.1|[local::at0169],
											0.2|[local::at0170],
											0.3|[local::at0171]
										}
									}
									ELEMENT[at0079] occurrences matches {0..1} matches {    -- Total degrees of adduction
										value matches {
											0.0|[local::at0172],
											0.05|[local::at0173],
											0.1|[local::at0174],
											0.15|[local::at0175]
										}
									}
									ELEMENT[at0085] occurrences matches {0..1} matches {    -- HHS total
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::380]>
												list = <
													["1"] = <
														units = <"1">
														magnitude = <|0.0..100.0|>
														precision = <|2|>
													>
												>
											>
										}
									}
									ELEMENT[at0160] occurrences matches {0..1} matches {    -- mHHS raw total
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::380]>
												list = <
													["1"] = <
														units = <"1">
														magnitude = <|0.0..91.0|>
														precision = <|2|>
													>
												>
											>
										}
									}
									ELEMENT[at0162] occurrences matches {0..1} matches {    -- mHHS normalised total
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::380]>
												list = <
													["1"] = <
														units = <"1">
														magnitude = <|0.0..100.0|>
														precision = <|2|>
													>
												>
											>
										}
									}
									ELEMENT[at0086] occurrences matches {0..1} matches {    -- Grading
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0087,    -- Poor
													at0088,    -- Fair
													at0089,    -- Good
													at0090]    -- Excellent
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0047] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0084] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Harris Hip Score (HHS)">
					description = <"An assessment score used to evaluate the functional capacity of an individual following hip surgery.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Pain">
					description = <"">
				>
				["at0005"] = <
					text = <"None, or ignores it">
					description = <"">
				>
				["at0006"] = <
					text = <"Slight, occasional, no compromise in activity">
					description = <"">
				>
				["at0007"] = <
					text = <"Mild pain, no effect on average activities, rarely moderate pain with unusual activity, may take aspirin">
					description = <"">
				>
				["at0008"] = <
					text = <"Moderate pain, tolerable but makes concessions to pain. Some limitations of ordinary activity or work. May require occasional pain medication stronger than aspirin">
					description = <"">
				>
				["at0009"] = <
					text = <"Marked pain, serious limitation of activities">
					description = <"">
				>
				["at0010"] = <
					text = <"Totally disabled, crippled, pain in bed, bedridden">
					description = <"">
				>
				["at0011"] = <
					text = <"Support devices">
					description = <"">
				>
				["at0012"] = <
					text = <"None">
					description = <"">
