		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Harris Hip Score (HHS)">
					description = <"En vurderingsskår som brukes til å evaluere den funksjonelle kapasiteten hos en person etter en hofteoperasjon.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Uspesifisert tidspunkthendelse">
					description = <"Uspesifisert tidspunkt som kan defineres mer eksplisitt i en templat eller i en applikasjon.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Smerte">
					description = <"">
				>
				["at0005"] = <
					text = <"Ingen">
					description = <"">
				>
				["at0006"] = <
					text = <"Lett verking/smerte uten innvirkning på funksjon">
					description = <"Svak">
				>
				["at0007"] = <
					text = <"Noe vondt etter mye aktivitet, behov for reseptfri smertestillende">
					description = <"Lett">
				>
				["at0008"] = <
					text = <"Tolerabel, men pasienten plages jevnlig. Kan hemme vanlig aktivitet, kan trenge sterkere smertestillende enn paracet">
					description = <"Moderat">
