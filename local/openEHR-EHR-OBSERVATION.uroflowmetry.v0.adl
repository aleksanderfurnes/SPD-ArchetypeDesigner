					text = <"Measurements parameters">
					description = <"">
				>
				["at0006"] = <
					text = <"Clinical interpretation">
					description = <"Overall clinical interpretation about all of the measurements and calculated ratios.">
				>
				["at0007"] = <
					text = <"Comment">
					description = <"Additional narrative about the <insert appropriate phrase here, for example ‘test results and interpretation’> not captured in other fields.">
				>
				["at0008"] = <
					text = <"Multimedia representation">
					description = <"Digital image, video or diagram representing the findings.">
					comment = <"For ">
				>
				["at0009"] = <
					text = <"Maximum flow rate">
					description = <"The highest speed of urine flow during the test.">
				>
				["at0010"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0012"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0013"] = <
					text = <"Confounding factors">
					description = <"(Additional) Issues or factors that may impact on <the measurement of body temperature>, not captured in other fields.">
				>
				["at0014"] = <
					text = <"Position">
					description = <"The body position of the individual at the time of measurement.">
				>
				["at0018"] = <
					text = <"Voided volume">
					description = <"The total volume collected in the measuring device during the recorded voiding period.

The total amount of urine passed during the test.">
				>
				["at0019"] = <
					text = <"Average flow rate">
					description = <"The total volume of urine divided by the total time it took to urinate.">
				>
				["at0020"] = <
					text = <"Time to maximum flow">
					description = <"How long it takes to reach peak flow speed from the start.">
				>
				["at0021"] = <
					text = <"Flow time">
					description = <"Time interval when voiding occurs, without intervals between separate micturitions.">
				>
				["at0022"] = <
					text = <"Standing">
					description = <"Standing at the time of measurement.">
				>
				["at0023"] = <
					text = <"Sitting">
					description = <"Sitting at the time of measurement.">
				>
				["at0026"] = <
					text = <"Flow curve">
					description = <"Description of the flow curve shape. ">
					comment = <"For example normal or abnormal....">
				>
				["at0027"] = <
					text = <"Voiding time">
					description = <"Time interval from the beginning to the end of voiding, including intervals between separate micturitions.">
				>
				["at0028"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0029"] = <
					text = <"Device">
					description = <"Details of the device used to measure uroflowmetry.">
				>
			>
		>
