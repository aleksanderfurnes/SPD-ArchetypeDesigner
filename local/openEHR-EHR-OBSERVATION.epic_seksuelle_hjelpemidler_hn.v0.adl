definition
	OBSERVATION[at0000] matches {    -- epic_seksuelle_hjelpemidler_hn
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0005] occurrences matches {0..1} matches {    -- En del menn bruker hjelpemidler som tabletter, sprøyter eller pumpe for å bedre på ereksjonen. Dersom du har brukt hjelpemidler for ereksjonen, merk av hvilke du har brukt i løpet av de siste 4 ukene?
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0004] occurrences matches {0..1} matches {    -- Tabletter (for eksempel Viagra, Revatio, Sildenafil, Cialis, Adcirca, Levitra)
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0007,    -- Ja
															at0008]    -- Nei
														}
													}
												}
											}
											ELEMENT[at0009] occurrences matches {0..1} matches {    -- Injeksjoner/sprøyter
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0010,    -- Ja
															at0011]    -- Nei
														}
													}
												}
											}
											ELEMENT[at0012] occurrences matches {0..1} matches {    -- Vakuumpumpe
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0013,    -- Ja
															at0014]    -- Nei
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0006] matches {*}    -- Item tree
		}
	}

