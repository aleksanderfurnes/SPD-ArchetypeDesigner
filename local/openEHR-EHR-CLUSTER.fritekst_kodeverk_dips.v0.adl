definition
	CLUSTER[at0000] matches {    -- Fritekst kodeverk dips
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Type fritekst
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- 1 Kommunikasjon/sanser
							at0003,    -- 2 Kunnskap/utvikling/psykisk
							at0004,    -- 3 Åndedrett/sirkulasjon
							at0005,    -- 4 Ernæring/væske/elektrolyttbalanse
							at0006,    -- 5 Eliminasjon
							at0007,    -- 6 Hud/vev/sår
							at0008,    -- 7 Aktivitet/funksjons-status
							at0009,    -- 8 Smerte/søvn/hvile/velvære
							at0010,    -- 9 Seksualitet/reproduksjon
							at0011,    -- 10 Sosialt/planlegging av utskrivelse
							at0012,    -- 11 Åndelig/kulturelt/livsstil
							at0013]    -- 12 Annet/legedelegerte aktiviteter og observasjoner
						}
					}
				}
			}
		}
	}

