		["revision"] = <"0.0.1-alpha">
	>

definition
	OBSERVATION[at0000] matches {    -- iciq_ui_short_hn
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					POINT_EVENT[at0002] occurrences matches {0..1} matches {    -- Point in time
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Frequency
										value matches {
											0|[local::at0005],
											1|[local::at0006],
											2|[local::at0007],
											3|[local::at0008],
											4|[local::at0009],
											5|[local::at0010]
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Quantity
										value matches {
											0|[local::at0012],
											2|[local::at0013],
											4|[local::at0014],
											6|[local::at0015]
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {    -- Interference with daily life
										value matches {
											1|[local::at0031],
											2|[local::at0032],
											3|[local::at0033],
											4|[local::at0034],
											5|[local::at0035],
											6|[local::at0036],
											7|[local::at0037],
											8|[local::at0038],
											9|[local::at0039],
											10|[local::at0040]
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {    -- ICIQ Score
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..21|}
											}
										}
									}
									ELEMENT[at0018] occurrences matches {0..*} matches {    -- When does urine leak?
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0019,    -- Never
													at0020,    -- Before getting to toilet
													at0021,    -- Cough or sneeze
													at0022,    -- Asleep
													at0023,    -- Physically active/exercising
													at0024,    -- Finished urinating and are dressed
													at0025,    -- No obvious reason
													at0026]    -- All the time
												}
											}
										}
									}
									CLUSTER[at0041] occurrences matches {0..1} matches {*}    -- CLUSTER
								}
							}
						}
						state matches {
							ITEM_TREE[at0027] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0028] occurrences matches {0..*} matches {    -- Confounding factors
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0029] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0030] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"iciq_ui_short_hn">
					description = <"International Consultation on Incontinence (ICIQ) Urinary Incontinence (UI) Short Form.">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Point in time">
					description = <"A specific date and/or time which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Frequency">
					description = <"Frequency of urine leakage over past 4 weeks.">
					comment = <"Prompt: On average over the past 4 weeks, how often do you leak urine?">
				>
				["at0005"] = <
					text = <"Never">
					description = <"Over the past 4 weeks I have never leaked urine.">
				>
				["at0006"] = <
					text = <"About once a week or less often">
					description = <"Over the past 4 weeks I have leaked urine about once a week or less often on average.">
				>
				["at0007"] = <
					text = <"Two or three times a week">
					description = <"Over the past 4 weeks I have leaked urine two or three times a week on average.">
				>
				["at0008"] = <
					text = <"About once a day">
					description = <"Over the past 4 weeks I have leaked urine about once a day on average.">
				>
				["at0009"] = <
					text = <"Several times a day">
					description = <"Over the past 4 weeks I have leaked urine several times a day on average.">
				>
				["at0010"] = <
					text = <"All the time">
					description = <"Over the past 4 weeks I have leaked urine all the time.">
				>
				["at0011"] = <
					text = <"Quantity">
					description = <"Perceived quantity of urine leakage.">
					comment = <"Prompt: We would like to know how much urine you think leaks. 
How much urine do you usually leak (whether you wear protection or not)?">
				>
				["at0012"] = <
					text = <"None">
					description = <"Over the past 4 weeks I have not leaked any urine.">
				>
				["at0013"] = <
					text = <"A small amount">
					description = <"Over the past 4 weeks I have leaked a small amount of urine on average.">
				>
				["at0014"] = <
					text = <"A moderate amount">
					description = <"Over the past 4 weeks I have leaked a moderate amount of urine on average.">
				>
				["at0015"] = <
					text = <"A large amount">
					description = <"Over the past 4 weeks I have leaked a large amount of urine on average.">
				>
				["at0016"] = <
					text = <"Interference with daily life">
					description = <"Perceived interference of urine leakage with daily life on a scale of 0 - 10.">
					comment = <"Prompt: Overall, how much does leaking urine interfere with your everyday life?
 Please record a number between 0 (not at all) and 10 (a great deal)">
				>
				["at0017"] = <
					text = <"ICIQ Score">
					description = <"Sum of scores for frequency, quantity and interference.">
				>
				["at0018"] = <
					text = <"When does urine leak?">
					description = <"Occasions when urine leakage occurs.">
					comment = <"Prompt: When does urine leak? (Please tick all that apply to you).">
				>
				["at0019"] = <
					text = <"Never">
					description = <"Urine never leaks.">
				>
				["at0020"] = <
					text = <"Before getting to toilet">
					description = <"Urine leaks before you can get to the toilet.">
				>
				["at0021"] = <
					text = <"Cough or sneeze">
					description = <"Urine leaks when you cough or sneeze.">
				>
				["at0022"] = <
					text = <"Asleep">
					description = <"Urine leaks when you are asleep.">
				>
				["at0023"] = <
					text = <"Physically active/exercising">
					description = <"Urine leaks when you are physically active or exercising.">
				>
				["at0024"] = <
					text = <"Finished urinating and are dressed">
					description = <"Urine leaks when you have finished urinating and are dressed.">
				>
				["at0025"] = <
					text = <"No obvious reason">
					description = <"Urine leaks for no obvious reason.">
				>
				["at0026"] = <
					text = <"All the time">
					description = <"Urine leaks all the time.">
				>
				["at0027"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0028"] = <
					text = <"Confounding factors">
					description = <"Description of any incidental factors that may have contributed to the score.">
				>
				["at0029"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0030"] = <
					text = <"Extension">
					description = <"Additional information required to capture local content or to align with other reference models/formalisms.">
					comment = <"e.g. Local information requirements or additional metadata to align with FHIR or CIMI equivalents.">
				>
				["at0031"] = <
					text = <"*1 (nb)">
					description = <"">
				>
				["at0032"] = <
					text = <"*2 (nb)">
					description = <"">
				>
				["at0033"] = <
					text = <"*3 (nb)">
					description = <"">
				>
				["at0034"] = <
					text = <"*4 (nb)">
					description = <"">
				>
				["at0035"] = <
					text = <"*5 (nb)">
					description = <"">
				>
				["at0036"] = <
					text = <"*6 (nb)">
					description = <"">
				>
				["at0037"] = <
					text = <"*7 (nb)">
					description = <"">
				>
				["at0038"] = <
					text = <"*8 (nb)">
					description = <"">
				>
				["at0039"] = <
					text = <"*9 (nb)">
					description = <"">
				>
				["at0040"] = <
					text = <"*10 (nb)">
					description = <"">
				>
				["at0041"] = <
					text = <"CLUSTER">
					description = <"">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"iciq_ui_short_hn">
					description = <"*International Consultation on Incontinence (ICIQ) Urinary Incontinence (UI) Short Form. (en)">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Uspesifisert tidspunkthendelse">
					description = <"Uspesifisert tidspunkt som kan defineres mer eksplisitt i en templat eller i en applikasjon.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Hyppighet">
					description = <"Hyppighet av urinlekkasje de siste 4 ukene.">
					comment = <"Spørsmål: I gjennomsnitt de siste 4 ukene, hvor ofte lekker du urin?">
				>
				["at0005"] = <
					text = <"Aldri">
					description = <"De siste fire ukene har jeg aldri lekket urin.">
				>
				["at0006"] = <
					text = <"Omtrent én gang i uken eller sjeldnere">
					description = <"løpet av de siste fire ukene har jeg lekket urin omtrent én gang i uken eller sjeldnere i gjennomsnitt.">
				>
				["at0007"] = <
					text = <"2-3 ganger i uken">
					description = <"I løpet av de siste fire ukene har jeg lekket urin to eller tre ganger i uken i gjennomsnitt.">
				>
				["at0008"] = <
					text = <"Ca. 1 gang per dag">
					description = <"De siste fire ukene har jeg lekket urin omtrent én gang om dagen i gjennomsnitt.">
				>
				["at0009"] = <
					text = <"Flere ganger per dag">
					description = <"I løpet av de siste fire ukene har jeg lekket urin flere ganger om dagen i gjennomsnitt.">
				>
				["at0010"] = <
					text = <"Hele tiden">
					description = <"De siste fire ukene har jeg lekket urin hele tiden.">
				>
				["at0011"] = <
					text = <"Mengde">
					description = <"Opplevd mengde urinlekkasje.">
					comment = <"Spørsmål: Vi vil gjerne vite hvor mye urin du tror lekker. Hvor mye urin lekker du vanligvis (enten du bruker beskyttelse eller ikke)?">
				>
				["at0012"] = <
					text = <"Ikke noe">
					description = <"De siste fire ukene har jeg ikke lekket urin.">
				>
				["at0013"] = <
					text = <"En liten mengde">
					description = <"I løpet av de siste fire ukene har jeg lekket en liten mengde urin i gjennomsnitt.">
				>
				["at0014"] = <
					text = <"En moderat mengde">
					description = <"løpet av de siste fire ukene har jeg lekket en moderat mengde urin i gjennomsnitt.">
				>
				["at0015"] = <
					text = <"En stor mengde">
					description = <"I løpet av de siste fire ukene har jeg lekket en gjennomsnittlig mengde urin.">
				>
				["at0016"] = <
					text = <"Forstyrrelse i dagliglivet">
					description = <"Opplevd forstyrrelse av urinlekkasje i dagliglivet på en skala fra 0–10.">
					comment = <"Spørsmål: Hvor mye påvirker urinlekkasje ditt hverdagsliv? Vær vennlig, sett en ring rundt et tall mellom 0 (ikke i det hele tatt) og 10 (mye)">
				>
				["at0017"] = <
					text = <"ICIQ-skår">
					description = <"Sum av poengsummer for frekvens, mengde og interferens.">
				>
				["at0018"] = <
					text = <"Når lekker du urin?">
					description = <"Anledninger når det oppstår urinlekkasje.">
					comment = <"Spørsmål: Når lekker urin? (Kryss av for alt som gjelder for deg).">
				>
				["at0019"] = <
					text = <"Aldri, jeg lekker ikke urin">
					description = <"Urin lekker aldri.">
				>
				["at0020"] = <
					text = <"Lekker før jeg når toalettet">
					description = <"Urin lekker før du rekker å komme på toalettet.">
				>
				["at0021"] = <
					text = <"Lekker når jeg hoster eller nyser">
					description = <"Urin lekker når du hoster eller nyser.">
				>
				["at0022"] = <
					text = <"Lekker når jeg sover">
					description = <"Urin lekker når du sover.">
				>
				["at0023"] = <
					text = <"Lekker når jeg er fysisk aktiv/trimmer">
					description = <"Urin lekker når du er fysisk aktiv eller trener.">
				>
				["at0024"] = <
					text = <"Lekker når jeg er ferdig med å late vannet og har tatt på meg klærne">
					description = <"Urin lekker når du er ferdig med å urinere og er påkledd.">
				>
				["at0025"] = <
					text = <"Ingen åpenbar grunn">
					description = <"Urin lekker uten noen åpenbar grunn.">
				>
				["at0026"] = <
					text = <"Lekker hele tiden">
					description = <"Urin lekker hele tiden.">
				>
				["at0027"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0028"] = <
					text = <"Konfunderende faktorer">
					description = <"Ytterligere problemstillinger eller faktorer som kan påvirke skåringen.">
				>
				["at0029"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0030"] = <
					text = <"Utvidelse">
					description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.">
					comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.">
				>
				["at0031"] = <
					text = <"1">
					description = <"">
				>
				["at0032"] = <
					text = <"2">
					description = <"">
				>
				["at0033"] = <
					text = <"3">
					description = <"">
				>
				["at0034"] = <
					text = <"4">
					description = <"">
				>
				["at0035"] = <
					text = <"5">
					description = <"">
				>
				["at0036"] = <
					text = <"6">
					description = <"">
				>
				["at0037"] = <
					text = <"7">
					description = <"">
				>
				["at0038"] = <
					text = <"8">
					description = <"">
				>
				["at0039"] = <
					text = <"9">
					description = <"">
				>
				["at0040"] = <
					text = <"10">
					description = <"">
				>
				["at0041"] = <
					text = <"Når lekker du urin?">
					description = <"">
				>
			>
		>
	>
