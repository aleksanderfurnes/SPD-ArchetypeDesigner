										}
									}
									ELEMENT[at0079] occurrences matches {0..1} matches {    -- Sosialstatus
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0080] occurrences matches {0..1} matches {    -- Røykestatus
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0081] occurrences matches {0..1} matches {    -- Hvis ja, antall pakkår
										value matches {
											DV_COUNT matches {*}
										}
									}
									ELEMENT[at0082] occurrences matches {0..1} matches {    -- Hvis tidligere røyker, antall måneder siden du sluttet
										value matches {
											DV_DURATION matches {*}
										}
									}
									ELEMENT[at0083] occurrences matches {0..1} matches {    -- Alkoholbruk
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0084] occurrences matches {0..1} matches {    -- Primær diagnose (f.eks. ICD10)
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0085] occurrences matches {0..1} matches {    -- Dato for primær diagnose
										value matches {
											DV_DATE matches {*}
										}
									}
									ELEMENT[at0086] occurrences matches {0..1} matches {    -- Metode for primær diagnose
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0087] occurrences matches {0..1} matches {    -- Performance status (f.eks. ECOG, Karnofsky) / datoer
										value matches {
											DV_TEXT matches {*}
										}
									}
