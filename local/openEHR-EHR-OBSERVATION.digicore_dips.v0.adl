definition
	OBSERVATION[at0000] matches {    -- DIGICORE_DIPS
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0067] occurrences matches {0..1} matches {    -- HF, stråleterapisenter
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0068] occurrences matches {0..1} matches {    -- Henvisende instans
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0069] occurrences matches {0..1} matches {    -- Registreringsdato/dato for signert samtykke
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0070] occurrences matches {0..1} matches {    -- Behandlende lege
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0071] occurrences matches {0..1} matches {    -- År
										value matches {
											DV_DURATION matches {*}
										}
									}
									ELEMENT[at0072] occurrences matches {0..1} matches {    -- Alder ved stråleterapioppstart
										value matches {
											DV_DURATION matches {*}
										}
									}
									ELEMENT[at0073] occurrences matches {0..1} matches {    -- Kjønn
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0074] occurrences matches {0..1} matches {    -- Vekt
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::124]>
												list = <
													["1"] = <
														units = <"kg">
													>
												>
											>
										}
									}
									ELEMENT[at0075] occurrences matches {0..1} matches {    -- Høyde
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::122]>
												list = <
													["1"] = <
														units = <"cm">
													>
												>
											>
										}
									}
									ELEMENT[at0076] occurrences matches {0..1} matches {    -- Pasient-ID
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0077] occurrences matches {0..1} matches {    -- Samtykke (se over: dato for registrering)
										value matches {
