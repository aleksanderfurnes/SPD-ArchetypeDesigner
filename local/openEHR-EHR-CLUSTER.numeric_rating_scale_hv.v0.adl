definition
	CLUSTER[at0000] matches {    -- numeric_rating_scale_hv
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Rated concept
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- 0-10
				value matches {
					DV_COUNT matches {
						magnitude matches {|0..10|}
					}
					0|[local::at0004],
					1|[local::at0005],
					2|[local::at0006],
					3|[local::at0007],
					4|[local::at0008],
					5|[local::at0009],
					6|[local::at0010],
					7|[local::at0011],
					8|[local::at0012],
					9|[local::at0013],
					10|[local::at0014]
				}
			}
			ELEMENT[at0015] occurrences matches {0..1} matches {    -- Comment
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

