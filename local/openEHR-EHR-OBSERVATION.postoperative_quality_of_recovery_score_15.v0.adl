											}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- Getting support from hospital doctors and nurses
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..10|}
											}
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Able to return to work or usual home activities
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..10|}
											}
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {    -- Feeling comfortable and in control
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..10|}
											}
										}
									}
									ELEMENT[at0013] occurrences matches {0..1} matches {    -- Having a feeling of general well-being
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..10|}
											}
										}
									}
									ELEMENT[at0014] occurrences matches {0..1} matches {    -- Moderate pain
										value matches {
