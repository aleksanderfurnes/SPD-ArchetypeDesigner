		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Quality of Recovery 15">
					description = <"postoperative_quality_of_recovery_score_15">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Siste 24 timer">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Har kunnet puste lett">
					description = <"Selvvurdert oppfatning av evnen til å puste lett.">
					comment = <"0 = Ikke i det hele tatt [dårlig] og 10 = Hele tiden [utmerket].">
				>
				["at0005"] = <
					text = <"Har hatt matlyst">
					description = <"Selvvurdert oppfatning av evnen til å nyte mat.">
					comment = <"0 = Ikke i det hele tatt [dårlig] og 10 = Hele tiden [utmerket].">
				>
				["at0006"] = <
					text = <"Har følt meg uthvilt">
					description = <"Selvvurdert oppfatning av å føle seg uthvilt.">
					comment = <"0 = Ikke i det hele tatt [dårlig] og 10 = Hele tiden [utmerket].">
				>
				["at0007"] = <
					text = <"Har sovet godt">
					description = <"Selvvurdert oppfatning av evnen til å sove godt.">
					comment = <"0 = Ikke i det hele tatt [dårlig] og 10 = Hele tiden [utmerket].">
				>
				["at0008"] = <
					text = <"Har klart å ivareta personlig hygiene uten hjelp">
					description = <"Selvvurdert oppfatning av evnen til å ivareta personlig toalett og hygiene uten hjelp.">
					comment = <"0 = Ikke i det hele tatt [dårlig] og 10 = Hele tiden [utmerket].">
				>
				["at0009"] = <
					text = <"Har klart å kommunisere med familie og/eller venner">
					description = <"Selvvurdert oppfatning av evnen til å kommunisere med familie eller venner.">
					comment = <"0 = Ikke i det hele tatt [dårlig] og 10 = Hele tiden [utmerket].">
				>
				["at0010"] = <
					text = <"Har fått støtte fra leger og sykepleiere på sykehuset">
					description = <"Selvvurdert oppfatning av å få støtte fra leger og sykepleiere på sykehuset.">
					comment = <"0 = Ikke i det hele tatt [dårlig] og 10 = Hele tiden [utmerket].">
				>
				["at0011"] = <
					text = <"Kunne ha gjenopptatt arbeid eller vanlige gjøremål i hjemmet">
					description = <"Selvvurdert oppfatning av evnen til å gå tilbake til arbeid eller vanlige hjemmeaktiviteter.">
					comment = <"0 = Ikke i det hele tatt [dårlig] og 10 = Hele tiden [utmerket].">
				>
				["at0012"] = <
					text = <"Har følt meg vel og at jeg har kontroll">
					description = <"Selvvurdert oppfatning av å føle seg komfortabel og i kontroll.">
					comment = <"0 = Ikke i det hele tatt [dårlig] og 10 = Hele tiden [utmerket].">
				>
				["at0013"] = <
					text = <"Har følt meg i fin form">
					description = <"Selvvurdert oppfatning av generell velvære.">
					comment = <"0 = Ikke i det hele tatt [dårlig] og 10 = Hele tiden [utmerket].">
				>
				["at0014"] = <
					text = <"Moderate smerter">
					description = <"Selvvurdert oppfatning av moderat smerte.">
					comment = <" 10 representerer «Ikke noen gang» [utmerket] og 0 representerer «Hele tiden» [dårlig].">
				>
				["at0015"] = <
					text = <"Sterke smerter">
					description = <"Selvvurdert oppfatning av sterke smerter.">
					comment = <" 10 representerer «Ikke noen gang» [utmerket] og 0 representerer «Hele tiden» [dårlig].">
				>
				["at0016"] = <
					text = <"Kvalm eller oppkast">
					description = <"Selvvurdert oppfatning av kvalme eller oppkast.">
					comment = <" 10 representerer «Ikke noen gang» [utmerket] og 0 representerer «Hele tiden» [dårlig].">
				>
				["at0017"] = <
					text = <"Vært bekymret eller engstelig">
					description = <"Selvvurdert oppfatning av å føle seg bekymret eller engstelig.">
					comment = <" 10 representerer «Ikke noen gang» [utmerket] og 0 representerer «Hele tiden» [dårlig].">
				>
				["at0018"] = <
					text = <"Vært trist eller deprimert">
					description = <"Selvvurdert oppfatning av å føle seg trist eller deprimert.">
					comment = <" 10 representerer «Ikke noen gang» [utmerket] og 0 representerer «Hele tiden» [dårlig].">
				>
				["at0019"] = <
					text = <"Del A">
					description = <"Hvordan har du følt deg det siste døgnet?">
				>
				["at0020"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0021"] = <
					text = <"Del B">
					description = <"Har du opplevd noe av det følgende det siste døgnet?">
				>
			>
		>
