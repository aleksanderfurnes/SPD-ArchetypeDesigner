definition
	OBSERVATION[at0000] matches {    -- postoperative_quality_of_recovery_score_15
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					INTERVAL_EVENT[at0002] matches {    -- Last 24 hours
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0019] occurrences matches {0..1} matches {    -- Part A
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0004] occurrences matches {0..1} matches {    -- Able to breathe easily
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0005] occurrences matches {0..1} matches {    -- Been able to enjoy food
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0006] occurrences matches {0..1} matches {    -- Feeling rested
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0007] occurrences matches {0..1} matches {    -- Have a good sleep
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0008] occurrences matches {0..1} matches {    -- Able to look after personal toilet and hygiene unaided
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0009] occurrences matches {0..1} matches {    -- Able to communicate with family or friends
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0010] occurrences matches {0..1} matches {    -- Getting support from hospital doctors and nurses
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0011] occurrences matches {0..1} matches {    -- Able to return to work or usual home activities
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0012] occurrences matches {0..1} matches {    -- Feeling comfortable and in control
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0013] occurrences matches {0..1} matches {    -- Having a feeling of general well-being
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
										}
									}
									CLUSTER[at0021] occurrences matches {0..1} matches {    -- Part B
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0014] occurrences matches {0..1} matches {    -- Moderate pain
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0015] occurrences matches {0..1} matches {    -- Severe pain
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0016] occurrences matches {0..1} matches {    -- Nausea or vomiting
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0017] occurrences matches {0..1} matches {    -- Feeling worried or anxious
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
											ELEMENT[at0018] occurrences matches {0..1} matches {    -- Feeling sad or depressed
												value matches {
													DV_COUNT matches {
														magnitude matches {|0..10|}
													}
												}
											}
										}
									}
								}
							}
						}
						width matches {
							DV_DURATION matches {
								value matches {PT24H}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0020] matches {*}    -- Item tree
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"postoperative_quality_of_recovery_score_15">
					description = <"postoperative_quality_of_recovery_score_15">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Last 24 hours">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Able to breathe easily">
					description = <"Self-rated perception of ability to breathe easily.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0005"] = <
					text = <"Been able to enjoy food">
					description = <"Self-rated perception of ability to enjoy food.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0006"] = <
					text = <"Feeling rested">
					description = <"Self-rated perception of feeling rested.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0007"] = <
					text = <"Have a good sleep">
					description = <"Self-rated perception of ability to sleep well.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0008"] = <
					text = <"Able to look after personal toilet and hygiene unaided">
					description = <"Self-rated perception of ability to look after personal toilet and hygiene unaided.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0009"] = <
					text = <"Able to communicate with family or friends">
					description = <"Self-rated perception of ability to communicate with family or friends.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0010"] = <
					text = <"Getting support from hospital doctors and nurses">
					description = <"Self-rated perception of getting support from hospital doctors and nurses.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0011"] = <
					text = <"Able to return to work or usual home activities">
					description = <"Self-rated perception of ability to return to work or usual home activities.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0012"] = <
					text = <"Feeling comfortable and in control">
					description = <"Self-rated perception of feeling comfortable and in control.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0013"] = <
					text = <"Having a feeling of general well-being">
					description = <"Self-rated perception of general well-being.">
					comment = <"0 represents 'None of the time' [poor] and 10 represents 'All of the time' [excellent]. ">
				>
				["at0014"] = <
					text = <"Moderate pain">
					description = <"Self-rated perception of moderate pain.">
					comment = <"10 represents 'None of the time' [excellent] and 0 represents 'All of the time' [poor]. ">
				>
				["at0015"] = <
					text = <"Severe pain">
					description = <"Self-rated perception of severe pain.">
					comment = <"10 represents 'None of the time' [excellent] and 0 represents 'All of the time' [poor]. ">
				>
				["at0016"] = <
					text = <"Nausea or vomiting">
					description = <"Self-rated perception of nausea or vomiting.">
					comment = <"10 represents 'None of the time' [excellent] and 0 represents 'All of the time' [poor]. ">
				>
				["at0017"] = <
					text = <"Feeling worried or anxious">
					description = <"Self-rated perception of feeling worried or anxious.">
					comment = <"10 represents 'None of the time' [excellent] and 0 represents 'All of the time' [poor]. ">
				>
				["at0018"] = <
					text = <"Feeling sad or depressed">
					description = <"Self-rated perception of feeling sad or depressed.">
					comment = <"10 represents 'None of the time' [excellent] and 0 represents 'All of the time' [poor]. ">
				>
