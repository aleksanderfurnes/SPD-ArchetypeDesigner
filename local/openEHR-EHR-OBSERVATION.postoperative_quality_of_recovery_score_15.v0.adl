												magnitude matches {|0..10|}
											}
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {    -- Severe pain
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..10|}
											}
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {    -- Nausea or vomiting
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..10|}
											}
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {    -- Feeling worried or anxious
										value matches {
