definition
	CLUSTER[at0000] matches {    -- IVF_tidligere_forsok_hn
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Måned
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Årstall
				value matches {
					DV_COUNT matches {
						magnitude matches {|1900..2200|}
					}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Ved klinikk
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Resultat
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

