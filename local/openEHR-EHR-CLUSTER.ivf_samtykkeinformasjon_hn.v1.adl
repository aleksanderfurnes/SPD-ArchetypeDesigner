definition
	CLUSTER[at0000] matches {    -- ivf_samtykkeinformasjon_hn
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0005] matches {    -- Vi bekrefter at vi har hatt anledning til å overveie innholdet i dette dokumentet og be om ytterligere opplysninger eller informasjon
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0006,    -- Ja
							at0007]    -- Nei
						}
					}
				}
			}
			ELEMENT[at0008] matches {    -- Vi samtykker til at journalnotat, prøveresultat og annet som angår vår behandling ved assistert befruktning kan legges inn i partners journal
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0009,    -- Ja
							at0010]    -- Nei
						}
					}
				}
			}
		}
	}

