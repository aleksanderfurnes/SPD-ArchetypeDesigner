definition
	CLUSTER[at0000] matches {    -- IVF_regelmessig_samleie_hn
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Har dere regelmessig samleie?
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0003,    -- Ja
							at0004]    -- Nei
						}
					}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Hvor ofte?
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0006,    -- 2 ganger eller oftere per uke
							at0007]    -- Planlagt rundt eggløsningstidspunkt
						}
					}
				}
			}
		}
	}

