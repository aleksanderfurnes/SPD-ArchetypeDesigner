definition
	OBSERVATION[at0000] matches {    -- Vannlatninger_per_24h
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0005] occurrences matches {0..1} matches {    -- Antall vannlatninger pr 24 timer
										value matches {
											DV_COUNT matches {
												magnitude matches {|-1..25|}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Vannlatninger_per_24h">
					description = <"Antall vannlatninger">
					comment = <"Før inngrepet registreres objektive pasientrapporterte data fra to hjemmetester pasientene utfører før første konsultasjon: et 24-timers vannlatningsskjema (miksjonsskjema) og 24-timers bleieveietest, samt objektive urodynamiske målinger utført ved preope">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
				>
				["at0003"] = <
