                        <term_definitions code="at0000">
                            <items id="text">EQ-5D-5L</items>
                            <items id="description">Et standardisert instrument for måling av helserelatert livskvalitet som består av et beskrivende system med fem dimensjoner og en visuell analog skala (VAS).
Det gir en strukturert metode for å registrere en persons selvrapporterte helsetilstand på vurderingsdagen.
</items>
                        </term_definitions>
