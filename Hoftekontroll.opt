                        <term_definitions code="at0000">
                            <items id="text">Hip disability and Osteoarthritis Outcome Score -12 items (HOOS-12)</items>
                            <items id="description">Hip disability and Osteoarthritis Outcome Score -12 items (HOOS-12) er et kortfattet, pasientrapportert spørreskjema med 12 spørsmål som brukes til å vurdere smerte, funksjonsbegrensninger og livskvalitet hos personer med hoftetilstander.</items>
                        </term_definitions>
                        <term_definitions code="at0001">
