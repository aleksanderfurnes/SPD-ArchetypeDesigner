                            <items id="description">Problemer med egenomsorg.</items>
                        </term_definitions>
                        <term_definitions code="at0007">
                            <items id="text">Vanlige gjøremål</items>
                            <items id="description">Problemer med vanlige aktiviteter.</items>
                            <items id="comment">f.eks arbeid, studier, husarbeid, familie- eller fritidsaktiviteter.</items>
                        </term_definitions>
                        <term_definitions code="at0008">
                            <items id="text">Smerter/ubehag</items>
                            <items id="description">Problemer med smerte eller ubehag.</items>
                        </term_definitions>
                        <term_definitions code="at0009">
                            <items id="text">Angest/depresjon</items>
                            <items id="description">Problem med angst eller depresjon.</items>
                        </term_definitions>
                        <term_definitions code="at0010">
                            <items id="text">Generell helse</items>
                            <items id="description">En egenvurdering av generell helse på en skala fra 0 til 100</items>
                        </term_definitions>
                        <term_definitions code="at0011">
                            <items id="text">Helse status</items>
                            <items id="description">En femsifret kode dannet av skårene for hver komponent, der 9 indikerer en manglende verdi.

En unik helsetilstand defineres ved å kombinere
ett nivå fra hver av de fem dimensjonene.
Totalt 3125 mulige helsetilstander defineres
på denne måten. Hver tilstand refereres til med
en femsifret kode.</items>
                            <items id="comment">f.eks '21491'</items>
                        </term_definitions>
