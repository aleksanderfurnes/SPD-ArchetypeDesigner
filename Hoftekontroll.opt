                        </term_definitions>
                        <term_definitions code="at0084">
                            <items id="text">Tilleggsinformasjon</items>
                            <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
                            <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items>
                        </term_definitions>
                        <term_definitions code="at0085">
                            <items id="text">Harris Hip Score totalskår</items>
                            <items id="description">Den totale summen av hver komponentparameter for Harris hoftescore.</items>
                        </term_definitions>
                        <term_definitions code="at0086">
                            <items id="text">Gradering</items>
                            <items id="description"></items>
                            <items id="comment">Gradering basert på den nettbaserte skårberegningen https://www.orthopaedicscore.com/scorepages/harris_hip_score.html</items>
                        </term_definitions>
                        <term_definitions code="at0087">
                            <items id="text">Dårlig</items>
                            <items id="description">Mindre enn 70.</items>
                        </term_definitions>
                        <term_definitions code="at0088">
                            <items id="text">Middels</items>
                            <items id="description">70-79.</items>
                        </term_definitions>
                        <term_definitions code="at0089">
                            <items id="text">God</items>
                            <items id="description">80-89.</items>
                        </term_definitions>
                        <term_definitions code="at0090">
                            <items id="text">Utmerket</items>
                            <items id="description">90-100.</items>
                        </term_definitions>
                        <term_definitions code="at0160">
                            <items id="text">Modified Harris Hip Score rå totalskår</items>
                            <items id="description">Den totale summen av hver komponentparameter for den modifiserte Harris hoftescore.</items>
                        </term_definitions>
                        <term_definitions code="at0162">
                            <items id="text">Modified Harris Hip Score normalisert totalskår</items>
                            <items id="description">Den justerte skåren for Modified Harris Hip Score, som representerer den rå skåren uttrykt på en 0–100-skala for sammenlignbarhet med den opprinnelige Harris Hip Score.</items>
                        </term_definitions>
