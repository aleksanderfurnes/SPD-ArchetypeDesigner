                        <term_definitions code="at0000">
                            <items id="text">Harris Hip Score</items>
                            <items id="description">En vurderingsskår som brukes til å evaluere den funksjonelle kapasiteten hos en person etter en hofteoperasjon.</items>
                        </term_definitions>
                        <term_definitions code="at0001">
                            <items id="text">History</items>
                            <items id="description">@ internal @</items>
                        </term_definitions>
                        <term_definitions code="at0002">
                            <items id="text">Uspesifisert tidspunkthendelse</items>
                            <items id="description">Uspesifisert tidspunkt som kan defineres mer eksplisitt i en templat eller i en applikasjon.</items>
                        </term_definitions>
                        <term_definitions code="at0003">
                            <items id="text">Tree</items>
                            <items id="description">@ internal @</items>
                        </term_definitions>
                        <term_definitions code="at0004">
                            <items id="text">B1. Hvor mye/ hva slags smerter har du i hoften?</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0005">
                            <items id="text">Ingen</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0006">
                            <items id="text">Lett verking/smerte uten innvirkning på funksjon</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0007">
                            <items id="text">Noe vondt etter mye aktivitet, behov for reseptfri smertestillende</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0008">
                            <items id="text">Tolerabel, men pasienten plages jevnlig. Kan hemme vanlig aktivitet, kan trenge sterkere smertestillende enn paracet</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0009">
                            <items id="text">Sterke smerter, men oppegående, hemmer aktivitet betydelig, behov for smertestillende sterkere enn paracet, noe nattsmerter</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0010">
                            <items id="text">Betydelig nattsmerte, klarer knapt gå pga av smerte</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0011">
                            <items id="text">B2. Har du behov for noen form for støtte når du går?</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0012">
                            <items id="text">Ingen</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0013">
                            <items id="text">En stokk lengre tur</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0014">
                            <items id="text">En stokk vanligvis</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0015">
                            <items id="text">En krykke</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0016">
                            <items id="text">To stokker</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0017">
                            <items id="text">To krykker eller umulig å gå</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0018">
                            <items id="text">B3. Hvor langt kan du gå?</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0019">
                            <items id="text">Ubegrenset</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0020">
                            <items id="text">1-1,5 km</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0021">
                            <items id="text">&lt;1 km</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0022">
                            <items id="text">Kun inne</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0023">
                            <items id="text">Seng til stol</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0024">
                            <items id="text">B4. Halter du når du går?</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0025">
                            <items id="text">Ingen</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0026">
                            <items id="text">Lett</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0027">
                            <items id="text">Middels</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0028">
                            <items id="text">Svær</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0029">
                            <items id="text">B5. Påkledning: Hvor lett er det å ta på sokker og sko?</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0030">
                            <items id="text">Uten vansker</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0031">
                            <items id="text">Med vansker</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0032">
                            <items id="text">Ikke i stand til</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0033">
                            <items id="text">B6. Hvordan går du i trapper?</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0034">
                            <items id="text">Normal</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0035">
                            <items id="text">Normal, støtte til rekkverk</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0036">
                            <items id="text">Ett trinn av gangen ved hjelp av rekkverk</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0037">
                            <items id="text">Umulig</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0038">
                            <items id="text">B7. Kollektivtransport</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0039">
                            <items id="text">Kan bruke kollektiv</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0040">
                            <items id="text">Umulig</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0041">
                            <items id="text">B8. Hvor komfortabel er du med å sitte?</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0042">
                            <items id="text">Sitter komfortabelt i en vanlig stol i 1 time</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0043">
                            <items id="text">Sitter på en høy stol i 30 minutter</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0044">
                            <items id="text">Ikke i stand til å sitte komfortabelt i noen stol</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0047">
                            <items id="text">Item tree</items>
                            <items id="description">@ internal @</items>
                        </term_definitions>
                        <term_definitions code="at0048">
                            <items id="text">B12. Deformitet</items>
                            <items id="description">Kriterier:&#13;
Fast fleksjonskontraktur mindre enn 30°&#13;
Fast adduksjon mindre enn 10°&#13;
Fast innadrotasjon i ekstensjon mindre enn 10°&#13;
Beinlengdeforskjell mindre enn 3,2 cm</items>
                            <items id="comment">4 = ingen deformitet
0 = Store problemer med bevegelse i hoften eller benlengdeforskjell over 3 cm</items>
                        </term_definitions>
                        <term_definitions code="at0052">
                            <items id="text">Totalt bevegelsesutslag i fleksjon</items>
                            <items id="description"></items>
                            <items id="comment">Intervaller basert på den nettbaserte skårberegningen https://www.orthopaedicscore.com/scorepages/harris_hip_score.html</items>
                        </term_definitions>
