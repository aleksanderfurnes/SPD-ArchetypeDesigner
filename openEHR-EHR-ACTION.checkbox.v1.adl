definition
	ACTION[at0000] matches {    -- Checkbox
		protocol matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Checkbox
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
				}
			}
		}
	}

